# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this later logs everyone out, invalidates new-style voting keys and makes saved email secrets unreadable.
FLASK_SECRET_KEY=

# Use letters and digits only so the generated DATABASE_URL stays valid.
POSTGRES_PASSWORD=

# Public address voters use, no trailing slash. Used in emails and shareable links.
PUBLIC_BASE_URL=https://vote.example.com

# First super admin. Created once on first start when no admin exists; remove ADMIN_PASSWORD afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- HTTPS (optional bundled proxy) -------------------------------------------
# Run with: docker compose --profile proxy up -d   (needs DNS pointing at this server)
DOMAIN=vote.example.com

# --- Email --------------------------------------------------------------------
# You can leave everything below blank and configure email in the admin (Settings > Email).
# Values set here win over the admin screen, which is handy for keeping secrets out of the database.
# EMAIL_PROVIDER=resend            # resend | smtp
# RESEND_API_KEY=re_xxxxxxxx
MAIL_SENDER=vote@example.com
MAIL_SENDER_NAME=Votilio
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls           # none | starttls | ssl
# SMTP_USER=
# SMTP_PASSWORD=

# --- Optional -----------------------------------------------------------------
# GMT offset or zone used to show and enter all dates. Can also be changed in Settings > General.
DISPLAY_TIMEZONE=GMT+0
# Set to false only for plain-http testing on a LAN.
# SESSION_COOKIE_SECURE=true
# Number of reverse proxies in front of the app (Caddy/nginx = 1).
# TRUSTED_PROXY_COUNT=1
# WEB_CONCURRENCY=2
# WEB_THREADS=4
# MAX_IMPORT_ROWS=20000
